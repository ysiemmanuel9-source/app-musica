{
  "expo": {
    "name": "Emmanuel",
    "slug": "emmanuel-music",
    "version": "1.0.0",
    "jsEngine": "jsc",
    "orientation": "portrait",
    "icon": "./assets/emmanuel-photo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/emmanuel-photo.png",
      "resizeMode": "cover",
      "backgroundColor": "#050718"
    },
    "assetBundlePatterns": [
      "assets/emmanuel-photo.png",
      "assets/reference-player.jpg"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emmanuel.music",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAppleMusicUsageDescription": "Emmanuel usa audio para reproducir tu musica."
      }
    },
    "android": {
      "package": "com.emmanuel.music"
    },
    "extra": {
      "eas": {
        "projectId": "62fbb08b-03bd-41ef-b4ca-47a4cfd29451"
      }
    },
    "owner": "emmanuel09"
  }
}
